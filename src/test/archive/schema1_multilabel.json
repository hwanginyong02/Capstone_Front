  "metricFormulas": [
    {
      "metricId": "M2",
      "name": "Precision",
      "formula": "binary: TP/(TP+FP) · 그 외: 클래스별 TP/(TP+FP) 의 macro 평균",
      "description": "Among predicted positives, measures how many are actually positive.",
      "isCommon": true
    },
    {
      "metricId": "M3",
      "name": "Recall",
      "formula": "binary: TP/(TP+FN) · 그 외: 클래스별 TP/(TP+FN) 의 macro 평균",
      "description": "Measures how many true positives are successfully detected.",
      "isCommon": true
    },
    {
      "metricId": "M4",
      "name": "F1 Score",
      "formula": "binary: 2PR/(P+R) · 그 외: 클래스별 F1 의 macro 평균(macro-P·macro-R 의 조화평균이 아님)",
      "description": "Balances precision and recall in a single metric.",
      "isCommon": true
    },
    {
      "metricId": "M15",
      "name": "Hamming Loss",
      "formula": "∑ (y_true ≠ y_pred) / (Samples * Labels)",
      "description": "Measures label-wise disagreement in multi-label classification.",
      "isCommon": false
    },
    {
      "metricId": "M16",
      "name": "Exact Match Ratio",
      "formula": "∑ (All_labels_match) / Samples",
      "description": "Counts samples where all labels exactly match.",
      "isCommon": false
    },
    {
      "metricId": "M17",
      "name": "Jaccard Index",
      "formula": "|y_true ∩ y_pred| / |y_true ∪ y_pred|",
      "description": "Measures intersection over union of predicted and actual labels.",
      "isCommon": false
    },
    {
      "metricId": "M21",
      "name": "Confusion Matrix",
      "formula": "실제/예측 클래스의 교차 분포를 행렬로 산출",
      "description": "Shows actual versus predicted counts by class or label.",
      "isCommon": true
    },
    {
      "metricId": "M22",
      "name": "Class-wise Metric",
      "formula": "개별 클래스별 P/R/F1 산출",
      "description": "Breaks down metrics for each class or label.",
      "isCommon": true
    },
    {
      "metricId": "M23",
      "name": "Imbalance Ratio",
      "formula": "max(class count) / min(class count)",
      "description": "Measures the balance of the evaluation dataset itself.",
      "isCommon": true
    }
  ],
