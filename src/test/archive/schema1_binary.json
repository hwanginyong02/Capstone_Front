  "metricFormulas": [
    {
      "metricId": "M1",
      "name": "Accuracy",
      "formula": "(TP + TN) / Total",
      "description": "Measures how often the classifier predicts the correct result.",
      "isCommon": true
    },
    {
      "metricId": "M2",
      "name": "Precision",
      "formula": "binary: TP/(TP+FP) · 그 외: 클래스별 TP/(TP+FP) 의 macro 평균",
      "description": "Among predicted positives, measures how many are actually positive.",
      "isCommon": true
    },
    {
      "metricId": "M3",
      "name": "Recall",
      "formula": "binary: TP/(TP+FN) · 그 외: 클래스별 TP/(TP+FN) 의 macro 평균",
      "description": "Measures how many true positives are successfully detected.",
      "isCommon": true
    },
    {
      "metricId": "M4",
      "name": "F1 Score",
      "formula": "binary: 2PR/(P+R) · 그 외: 클래스별 F1 의 macro 평균(macro-P·macro-R 의 조화평균이 아님)",
      "description": "Balances precision and recall in a single metric.",
      "isCommon": true
    },
    {
      "metricId": "M5",
      "name": "F-beta Score",
      "formula": "binary: (1+β²)PR/(β²P+R) · 그 외: 클래스별 Fβ 의 macro 평균",
      "description": "Adjusts the balance between precision and recall using beta.",
      "isCommon": true
    },
    {
      "metricId": "M9",
      "name": "AUROC",
      "formula": "Area under ROC Curve",
      "description": "Measures ranking quality across classification thresholds.",
      "isCommon": false
    },
    {
      "metricId": "M20",
      "name": "MCC",
      "formula": "(TP*TN - FP*FN) / √((TP+FP)(TP+FN)(TN+FP)(TN+FN))",
      "description": "A robust binary metric that considers all confusion matrix cells.",
      "isCommon": false
    },
    {
      "metricId": "M21",
      "name": "Confusion Matrix",
      "formula": "실제/예측 클래스의 교차 분포를 행렬로 산출",
      "description": "Shows actual versus predicted counts by class or label.",
      "isCommon": true
    },
    {
      "metricId": "M22",
      "name": "Class-wise Metric",
      "formula": "개별 클래스별 P/R/F1 산출",
      "description": "Breaks down metrics for each class or label.",
      "isCommon": true
    },
    {
      "metricId": "M23",
      "name": "Imbalance Ratio",
      "formula": "max(class count) / min(class count)",
      "description": "Measures the balance of the evaluation dataset itself.",
      "isCommon": true
    }
  ],
