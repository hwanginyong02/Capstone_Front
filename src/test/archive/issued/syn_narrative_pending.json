      "isCommon": true
    },
    {
      "metricId": "M3",
      "name": "Recall",
      "formula": "binary: TP/(TP+FN) · 그 외: 클래스별 TP/(TP+FN) 의 macro 평균",
      "description": "실제 양성 중 모델이 찾아낸 비율입니다.",
      "isCommon": true
    },
    {
      "metricId": "M4",
      "name": "F1 Score",
      "formula": "binary: 2PR/(P+R) · 그 외: 클래스별 F1 의 macro 평균(macro-P·macro-R 의 조화평균이 아님)",
      "description": "정밀도와 재현율을 하나로 묶어 균형을 봅니다.",
      "isCommon": true
    },
    {
      "metricId": "M9",
      "name": "AUROC",
      "formula": "Area under ROC Curve",
      "description": "모든 임계값에서 양성과 음성을 얼마나 잘 가르는지 봅니다.",
      "isCommon": false
    },
    {
      "metricId": "M10",
      "name": "AUPRC",
      "formula": "Area under PR Curve",
      "description": "모든 임계값에서 정밀도와 재현율이 맞바뀌는 정도를 봅니다.",
      "isCommon": false
    },
    {
      "metricId": "M19",
      "name": "Log Loss",
      "formula": "- (y * log(p) + (1-y) * log(1-p))",
      "description": "확신했지만 틀린 확률 예측에 큰 벌점을 줍니다.",
      "isCommon": false
    },
    {
      "metricId": "M23",
      "name": "Imbalance Ratio",
      "formula": "max(class count) / min(class count)",
      "description": "평가 데이터 자체의 클래스 균형을 봅니다.",
      "isCommon": true
    }
