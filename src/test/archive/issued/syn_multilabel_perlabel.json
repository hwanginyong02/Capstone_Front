    {
      "metricId": "M3",
      "name": "Recall",
      "formula": "binary: TP/(TP+FN) · 그 외: 클래스별 TP/(TP+FN) 의 macro 평균",
      "description": "실제 양성 중 모델이 찾아낸 비율입니다.",
      "isCommon": true
    },
    {
      "metricId": "M4",
      "name": "F1 Score",
      "formula": "binary: 2PR/(P+R) · 그 외: 클래스별 F1 의 macro 평균(macro-P·macro-R 의 조화평균이 아님)",
      "description": "정밀도와 재현율을 하나로 묶어 균형을 봅니다.",
      "isCommon": true
    },
    {
      "metricId": "M15",
      "name": "Hamming Loss",
      "formula": "∑ (y_true ≠ y_pred) / (Samples * Labels)",
      "description": "멀티레이블에서 레이블 단위로 틀린 비율입니다.",
      "isCommon": false
    },
    {
      "metricId": "M16",
      "name": "Exact Match Ratio",
      "formula": "∑ (All_labels_match) / Samples",
      "description": "모든 레이블이 정확히 맞은 표본의 비율입니다.",
      "isCommon": false
    },
    {
      "metricId": "M17",
      "name": "Jaccard Index",
      "formula": "|y_true ∩ y_pred| / |y_true ∪ y_pred|",
      "description": "예측 레이블과 실제 레이블의 교집합을 합집합으로 나눈 값입니다.",
      "isCommon": false
    },
    {
      "metricId": "M18",
      "name": "Distribution Diff (ML)",
      "formula": "1 - cos(freq(y_true), freq(y_pred))",
      "description": "실제 레이블 분포와 예측 레이블 분포를 비교합니다.",
      "isCommon": false
    },
    {
      "metricId": "M23",
      "name": "Imbalance Ratio",
      "formula": "max(class count) / min(class count)",
      "description": "평가 데이터 자체의 클래스 균형을 봅니다.",
      "isCommon": true
    }
  ],
