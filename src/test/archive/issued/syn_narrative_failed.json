  "metricFormulas": [
    {
      "metricId": "M1",
      "name": "Accuracy",
      "formula": "(TP + TN) / Total",
      "description": "모델이 맞게 예측한 비율입니다.",
      "isCommon": true
    },
    {
      "metricId": "M2",
      "name": "Precision",
      "formula": "binary: TP/(TP+FP) · 그 외: 클래스별 TP/(TP+FP) 의 macro 평균",
      "description": "양성으로 예측한 것 중 실제 양성인 비율입니다.",
      "isCommon": true
    },
    {
      "metricId": "M3",
      "name": "Recall",
      "formula": "binary: TP/(TP+FN) · 그 외: 클래스별 TP/(TP+FN) 의 macro 평균",
      "description": "실제 양성 중 모델이 찾아낸 비율입니다.",
      "isCommon": true
    },
    {
      "metricId": "M4",
      "name": "F1 Score",
      "formula": "binary: 2PR/(P+R) · 그 외: 클래스별 F1 의 macro 평균(macro-P·macro-R 의 조화평균이 아님)",
      "description": "정밀도와 재현율을 하나로 묶어 균형을 봅니다.",
      "isCommon": true
    },
    {
      "metricId": "M6",
      "name": "KL Divergence",
      "formula": "∑ P(x) * log(P(x) / Q(x))",
      "description": "정답 레이블의 분포와 모델이 예측한 클래스 레이블의 분포 간의 차이(Target Drift)를 계산합니다.",
      "isCommon": true
    },
    {
      "metricId": "M11",
      "name": "Macro Average",
      "formula": "클래스별 P·R·F1 의 macro 평균 — (Class1 + … + ClassN) / N",
      "description": "클래스별 지표를 같은 비중으로 평균합니다.",
      "isCommon": false
    },
    {
      "metricId": "M12",
      "name": "Micro Average",
      "formula": "micro 평균 — 전 클래스의 TP·FP·FN 을 합산해 P·R·F1 을 계산",
      "description": "모든 표본을 한데 모아 지표를 계산합니다.",
      "isCommon": false
    },
    {
      "metricId": "M23",
      "name": "Imbalance Ratio",
      "formula": "max(class count) / min(class count)",
      "description": "평가 데이터 자체의 클래스 균형을 봅니다.",
      "isCommon": true
    }
  ],
